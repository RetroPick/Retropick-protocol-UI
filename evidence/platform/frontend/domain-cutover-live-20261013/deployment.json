{
  "id": "dpl_9p4uikyzetTp3APK9mu9CY6WP7iR",
  "name": "retropick-metropolis-retro-ui-staging",
  "url": "retropick-metropolis-retro-ui-staging-1sxm7pzpb-asyams-projects.vercel.app",
  "readyState": "READY",
  "target": "production",
  "createdAt": 1791885315757,
  "aliases": [
    "retropick-metropolis-retro-ui-staging-asyams-projects.vercel.app"
  ],
  "routing": [
    {
      "framework": "vite",
      "installCommand": "pnpm install --filter '@retropick/retro-ui...' --frozen-lockfile",
      "buildCommand": "pnpm --filter @retropick/retro-ui build",
      "outputDirectory": "apps/retro-ui/dist",
      "rewrites": [
        {
          "source": "/v1/:path*",
          "destination": "https://api-staging.retropick.xyz/v1/:path*"
        },
        {
          "source": "/health",
          "destination": "https://api-staging.retropick.xyz/health"
        },
        {
          "source": "/api/referrals/:path*",
          "destination": "https://api-staging.retropick.xyz/api/referrals/:path*"
        },
        {
          "source": "/api/media/:path*",
          "destination": "https://api-staging.retropick.xyz/api/media/:path*"
        },
        {
          "source": "/api/radar/:path*",
          "destination": "https://api-staging.retropick.xyz/api/radar/:path*"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), publickey-credentials-get=(self), publickey-credentials-create=(self)"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data: blob:; connect-src 'self' https://testnet-rpc.monad.xyz https://rpc.ankr.com; worker-src 'self' blob:; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
            }
          ]
        }
      ],
      "name": "retropick-metropolis-retro-ui-staging",
      "version": 2
    }
  ]
}
