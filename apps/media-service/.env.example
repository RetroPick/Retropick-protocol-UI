# Token logo media service. Never put signing keys or wallet secrets here.
# Allowed browser origins for the upload POST (comma separated; dev vite origin first).
MEDIA_ORIGIN=http://127.0.0.1:3000
MEDIA_PORT=8790
MEDIA_DIR=.data/media
# Public base used for local-mode URIs (what other users' browsers will fetch).
MEDIA_PUBLIC_BASE=http://127.0.0.1:8790
# Optional Pinata API JWT. When set, uploads are pinned to IPFS and the service
# returns ipfs://<cid> URIs; when empty, files are stored locally (mode 'local').
PINATA_JWT=
