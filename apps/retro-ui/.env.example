# Fail-closed data mode (see src/lib/liquidity/registry.ts chooseDataMode).
# mock    — demo fixtures only (default).
# live    — reads the deployed RetroPick V2 contracts on Monad Testnet
#           (chain 10143) through the read indexer; requires VITE_INDEXER_URL.
VITE_DATA_MODE=mock

# RetroPick read indexer base URL (required for live mode).
# Local development: apps/indexer on loopback (pnpm --filter @retropick/indexer start).
VITE_INDEXER_URL=http://127.0.0.1:8787

# Monad Testnet RPC for direct contract reads. Primary endpoint; on
# deterministic RPC errors (e.g. 401/4xx) reads fail over in order to
# VITE_MONAD_RPC_FALLBACK_URL (default: the public endpoint below).
# VITE_MONAD_RPC_URL=https://monad-testnet.infura.io/v3/<YOUR-INFURA-PROJECT-KEY>
# VITE_MONAD_RPC_FALLBACK_URL=https://testnet-rpc.monad.xyz

# IPFS public gateway used to render ipfs:// logo URIs (default https://gateway.pinata.cloud;
# ipfs.io and dweb.link are bounded retry fallbacks). No secret values — Vite env is public.
# VITE_IPFS_GATEWAY=https://gateway.pinata.cloud
